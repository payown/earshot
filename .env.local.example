# Local development secrets — copy this file to .env.local and fill in your keys.
# .env.local is git-ignored. Never commit real credentials.

PODCAST_INDEX_API_KEY=your_key_here
PODCAST_INDEX_API_SECRET=your_secret_here

# Crash reporting. Optional for local dev, but REQUIRED for TestFlight/release
# builds — tool/testflight.sh refuses to build with an empty SENTRY_DSN unless
# you pass --no-crash-reporting. An empty DSN ships the build with crash
# reporting silently disabled.
SENTRY_DSN=

# Analytics. Optional — leave blank to disable. testflight.sh warns but does not
# block when this is empty.
POSTHOG_API_KEY=
